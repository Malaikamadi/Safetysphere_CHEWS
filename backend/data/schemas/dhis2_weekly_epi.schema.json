{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DHIS2 Weekly Epidemiological Report",
  "description": "Schema for weekly disease surveillance data exported from DHIS2. Each row represents one district-week observation with malaria case counts and environmental covariates.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "district",
      "rainfall_mm",
      "temperature_c",
      "humidity_percent",
      "water_stagnation_index",
      "mosquito_breeding_sites",
      "reported_fever_cases",
      "population_density",
      "malaria_cases"
    ],
    "properties": {
      "period": {
        "type": "string",
        "pattern": "^\\d{4}W\\d{2}$",
        "description": "ISO week period (e.g., 2026W30)"
      },
      "district": {
        "type": "string",
        "description": "District name"
      },
      "rainfall_mm": {
        "type": "number",
        "minimum": 0,
        "maximum": 500,
        "description": "Cumulative rainfall in mm for the period"
      },
      "temperature_c": {
        "type": "number",
        "minimum": 15,
        "maximum": 50,
        "description": "Mean temperature in Celsius"
      },
      "humidity_percent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "description": "Mean relative humidity (%)"
      },
      "water_stagnation_index": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Index of surface water stagnation (0–1 scale)"
      },
      "mosquito_breeding_sites": {
        "type": "integer",
        "minimum": 0,
        "description": "Count of identified breeding sites"
      },
      "reported_fever_cases": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of fever cases reported to health facilities"
      },
      "population_density": {
        "type": "number",
        "minimum": 0,
        "description": "Population density (persons per km²)"
      },
      "malaria_cases": {
        "type": "integer",
        "minimum": 0,
        "description": "Confirmed + suspected malaria cases"
      }
    }
  }
}
