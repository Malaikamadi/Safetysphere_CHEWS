# CHEWS environment (copy to .env — never commit .env)
# DHIS2 Analytics ingestion for Sierra Leone HMIS

# Base URL with no trailing slash
DHIS2_BASE_URL=https://sl.dhis2.org/hmis23

# Basic authentication (preferred for HMIS). Do not commit real values.
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Optional personal access token (DHIS2 ApiToken header). If set, used instead of basic auth.
# DHIS2_API_TOKEN=

# true = use bundled mock Analytics/org-unit fixtures (no network, no credentials)
DHIS2_MOCK_MODE=true

# Relative DHIS2 period or comma-separated fixed periods (e.g. 202509,202510 or LAST_12_MONTHS)
DHIS2_PERIOD=LAST_12_MONTHS

# Organisation unit dimension (LEVEL-5 = health facility in the verified SL hierarchy)
DHIS2_OU_DIMENSION=LEVEL-5

# HTTP
DHIS2_TIMEOUT_SECONDS=30
DHIS2_RETRIES=3

# Fetch supporting indicators (treatment 24h, testing coverage) in addition to core malaria set
DHIS2_INCLUDE_SUPPORTING=false

# Quality: flag extracts whose newest period is older than this many days
DHIS2_STALE_DAYS=60

# Historical malaria extract: explicit YYYYMM window (not LAST_5_YEARS).
# Default is N months ending at the last complete calendar month.
DHIS2_HISTORICAL_MONTHS=36
# DHIS2_HISTORICAL_START=202301
# DHIS2_HISTORICAL_END=202512
DHIS2_HISTORICAL_CHUNK_MONTHS=12

# Open-Meteo Archive (historical climate). Separate from realtime flood weather.
CLIMATE_ARCHIVE_MOCK_MODE=true
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CLIMATE_ARCHIVE_TIMEOUT_SECONDS=30

# Training-readiness bars for malaria_confirmed(t+1)
TRAINING_MIN_MONTHS=36
TRAINING_MIN_DISTRICTS=10
TRAINING_MIN_DISTRICT_MONTH_COMPLETENESS=0.5
TRAINING_MIN_CLIMATE_COVERAGE=0.9
TRAINING_MIN_TRAINABLE_ROWS=200
